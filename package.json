{
  "name": "@uni-helper/uni-env",
  "type": "module",
  "version": "0.3.1",
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "warn"
    }
  },
  "description": "在 uni-app 中优雅地判断当前环境。",
  "author": "KeJun",
  "maintainers": [
    {
      "email": "wurui.dev@gmail.com",
      "name": "ModyQyW",
      "url": "https://modyqyw.top"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/uni-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/uni-env.git"
  },
  "bugs": "https://github.com/uni-helper/uni-env/issues",
  "keywords": [
    "uni-app",
    "env"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "std-env": "^3.10.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "eslint": "^10.11.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}

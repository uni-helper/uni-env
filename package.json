{
  "name": "@uni-helper/uni-env",
  "type": "module",
  "version": "0.3.1",
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "warn"
    }
  },
  "description": "在 uni-app 中优雅地判断当前环境。",
  "author": "KeJun",
  "maintainers": [
    {
      "email": "wurui.dev@gmail.com",
      "name": "ModyQyW",
      "url": "https://modyqyw.top"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/uni-helper/uni-env#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uni-helper/uni-env.git"
  },
  "bugs": "https://github.com/uni-helper/uni-env/issues",
  "keywords": [
    "uni-app",
    "env"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "build:play:h5": "pnpm -C playground run build:h5",
    "dev:play:h5": "pnpm -C playground run dev:h5",
    "build:play:mp-weixin": "pnpm -C playground run build:mp-weixin",
    "dev:play:mp-weixin": "pnpm -C playground run dev:mp-weixin",
    "prepublishOnly": "pnpm build",
    "release": "bumpp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "std-env": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "eslint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
